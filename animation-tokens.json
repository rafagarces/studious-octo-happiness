{
  "duration": {
    "xs": "50ms",
    "s": "150ms",
    "m": "200ms",
    "l": "400ms",
    "xl": "600ms",
    "xxl": "1000ms"
  },
  "easing": {
    "linear": "cubic-bezier(0, 0, 0, 0)",
    "standard": "cubic-bezier(0.35, 0, 0.63, 1)",
    "emphasized-accelerate": "cubic-bezier(0.3, 0.0, 0.8, 0.15)",
    "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1.0)",
    "regular-accelerate": "cubic-bezier(0.3, 0, 1, 1)",
    "regular-decelerate": "cubic-bezier(0, 0, 0, 1)",
    "legacy-emphasized-accelerate": "cubic-bezier(0.7, 0, 0.8, 0)",
    "legacy-emphasized-decelerate": "cubic-bezier(0.08, 0.7, 0.12, 1.17)",
    "legacy-regular-accelerate": "cubic-bezier(0.6, 0, 1, 1)",
    "legacy-regular-decelerate": "cubic-bezier(0, 0, 0.3, 1.1)"
  },
  "animations": {
    "fade-in": {
      "duration": "m",
      "easing": "regular-decelerate",
      "description": "Simple fade in from transparent to opaque",
      "properties": {
        "from": { "opacity": 0 },
        "to": { "opacity": 1 }
      }
    },
    "fade-out": {
      "duration": "m",
      "easing": "regular-accelerate",
      "description": "Simple fade out from opaque to transparent",
      "properties": {
        "from": { "opacity": 1 },
        "to": { "opacity": 0 }
      }
    },
    "slide-up": {
      "duration": "l",
      "easing": "emphasized-decelerate",
      "description": "Slide in from bottom with smooth easing",
      "properties": {
        "from": {
          "transform": "translateY(20px)",
          "opacity": 0
        },
        "to": {
          "transform": "translateY(0)",
          "opacity": 1
        }
      }
    },
    "slide-down": {
      "duration": "l",
      "easing": "emphasized-decelerate",
      "description": "Slide in from top with smooth easing",
      "properties": {
        "from": {
          "transform": "translateY(-20px)",
          "opacity": 0
        },
        "to": {
          "transform": "translateY(0)",
          "opacity": 1
        }
      }
    },
    "slide-left": {
      "duration": "l",
      "easing": "emphasized-decelerate",
      "description": "Slide in from right",
      "properties": {
        "from": {
          "transform": "translateX(20px)",
          "opacity": 0
        },
        "to": {
          "transform": "translateX(0)",
          "opacity": 1
        }
      }
    },
    "slide-right": {
      "duration": "l",
      "easing": "emphasized-decelerate",
      "description": "Slide in from left",
      "properties": {
        "from": {
          "transform": "translateX(-20px)",
          "opacity": 0
        },
        "to": {
          "transform": "translateX(0)",
          "opacity": 1
        }
      }
    },
    "scale-up": {
      "duration": "m",
      "easing": "emphasized-decelerate",
      "description": "Scale from smaller to normal size",
      "properties": {
        "from": {
          "transform": "scale(0.95)",
          "opacity": 0
        },
        "to": {
          "transform": "scale(1)",
          "opacity": 1
        }
      }
    },
    "scale-down": {
      "duration": "m",
      "easing": "emphasized-decelerate",
      "description": "Scale from larger to normal size",
      "properties": {
        "from": {
          "transform": "scale(1.05)",
          "opacity": 0
        },
        "to": {
          "transform": "scale(1)",
          "opacity": 1
        }
      }
    },
    "zoom-in": {
      "duration": "l",
      "easing": "regular-decelerate",
      "description": "Zoom in effect with fade",
      "properties": {
        "from": {
          "transform": "scale(0.8)",
          "opacity": 0
        },
        "to": {
          "transform": "scale(1)",
          "opacity": 1
        }
      }
    },
    "zoom-out": {
      "duration": "l",
      "easing": "regular-accelerate",
      "description": "Zoom out effect with fade",
      "properties": {
        "from": {
          "transform": "scale(1)",
          "opacity": 1
        },
        "to": {
          "transform": "scale(0.8)",
          "opacity": 0
        }
      }
    },
    "rotate-in": {
      "duration": "xl",
      "easing": "emphasized-decelerate",
      "description": "Rotate and fade in",
      "properties": {
        "from": {
          "transform": "rotate(-5deg) scale(0.95)",
          "opacity": 0
        },
        "to": {
          "transform": "rotate(0deg) scale(1)",
          "opacity": 1
        }
      }
    },
    "bounce-in": {
      "duration": "xl",
      "easing": "legacy-emphasized-decelerate",
      "description": "Bounce effect on entry",
      "properties": {
        "from": {
          "transform": "scale(0.3)",
          "opacity": 0
        },
        "to": {
          "transform": "scale(1)",
          "opacity": 1
        }
      }
    },
    "shake": {
      "duration": "xl",
      "easing": "standard",
      "description": "Shake animation for errors or attention",
      "keyframes": {
        "0%, 100%": { "transform": "translateX(0)" },
        "10%, 30%, 50%, 70%, 90%": { "transform": "translateX(-5px)" },
        "20%, 40%, 60%, 80%": { "transform": "translateX(5px)" }
      }
    },
    "pulse": {
      "duration": "xxl",
      "easing": "standard",
      "description": "Pulsing scale animation",
      "keyframes": {
        "0%, 100%": { "transform": "scale(1)" },
        "50%": { "transform": "scale(1.05)" }
      }
    },
    "spin": {
      "duration": "xxl",
      "easing": "linear",
      "description": "Continuous rotation (for loaders)",
      "keyframes": {
        "from": { "transform": "rotate(0deg)" },
        "to": { "transform": "rotate(360deg)" }
      }
    }
  }
}
